# Supabase Configuration
# NEXT_PUBLIC_ variables are exposed to the browser (Client-side Supabase client respecting RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Server-side ONLY - NEVER expose to browser. Used for administrative and privileged tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Google Maps Platform (Browser client key, domain/HTTP-referrer restricted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-key

# Razorpay Payments (Server-side ONLY)
RAZORPAY_KEY_ID=rzp_test_...your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Gemini AI (Server-side ONLY)
GEMINI_API_KEY=your-gemini-api-key

# Email Notifications (Server-side ONLY)
EMAIL_API_KEY=your-email-service-api-key
FROM_EMAIL=notifications@srinutrition.com

# Application URL
APP_URL=http://localhost:3000

